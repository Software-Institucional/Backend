generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER
  ADMIN
  DOCENTE
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  firstName       String
  role            Role
  lastName        String
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt()
  activate        Boolean  @default(true)

  RefreshToken RefreshToken[]
  schools      SchoolsOnUsers[]

  createdById  String?
  createdBy    User?   @relation("UserCreations", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_resets")
}

model School {
  id           String  @id @default(uuid())
  name         String
  address      String?
  phone        String?
  imgUrl       String?
  department   String?
  municipality String?
  mail         String?
  website      String?
  activate     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users SchoolsOnUsers[]
  sedes Sede[]
}

model SchoolsOnUsers {
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  sede   Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  sedeId String?

  @@id([userId, schoolId])
  @@unique([userId, schoolId, sedeId])
  @@map("schools_on_users")
}

model Sede {
  id       String  @id @default(uuid())
  name     String
  address  String?
  phone    String?
  schoolId String

  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users  SchoolsOnUsers[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sedes")
}
